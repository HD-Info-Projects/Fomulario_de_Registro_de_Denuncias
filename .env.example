MYSQL_DATABASE=dados_denuncias
MYSQL_USER=denuncias_user
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password

SECRET_KEY=generate-a-secure-random-key
DATABASE_URI=mysql+pymysql://denuncias_user:change_this_database_password@localhost:3306/dados_denuncias

ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_admin_password

ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,mp4,mov,avi,mkv
UPLOAD_FOLDER=instance/uploads/denuncias
MAX_CONTENT_LENGTH=104857600
MAX_UPLOAD_FILE_SIZE=26214400
MAX_FILES_PER_DENUNCIA=5

FLASK_DEBUG=0
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

APP_BIND=127.0.0.1
APP_PORT=5000
SESSION_COOKIE_SECURE=1
RATELIMIT_STORAGE_URI=redis://redis:6379/0
RUN_MIGRATIONS=0
TRUSTED_PROXY_HOPS=0
